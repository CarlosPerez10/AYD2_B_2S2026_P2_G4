@startuml cun-negocio
' Modelo de casos de uso del negocio — Librería AYD
title Modelo de Casos de Uso del Negocio — Librería AYD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
left to right direction

actor/ "Cliente" as cliente
actor/ "Proveedor\n(editorial / distribuidor)" as proveedor
actor/ "Gerencia" as gerencia

rectangle "Librería AYD" <<negocio>> {
  usecase/ "CUN-01\nVender libros" as cun01
  usecase/ "CUN-02\nInformar disponibilidad\ndel catálogo" as cun02
  usecase/ "CUN-03\nAbastecer catálogo" as cun03
  usecase/ "CUN-04\nAnalizar títulos\nmás vendidos" as cun04
}

cliente -- cun01
cliente -- cun02
proveedor -- cun03
gerencia -- cun04

cun03 ..> cun02 : <<include>>
cun01 ..> cun02 : <<include>>

note bottom of cun04
  Proceso de apoyo a la decisión:
  define qué títulos reabastecer (CUN-03).
end note
@enduml
