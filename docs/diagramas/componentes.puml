@startuml componentes
' Diagrama de componentes UML — interfaces provistas (círculo) y requeridas (semicírculo)
title Diagrama de Componentes — Librería AYD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam nodesep 60
skinparam ranksep 70

component "Frontend\n(React + Nginx)" as fe

component "API Gateway" as gw {
  component "Autenticación admin" as auth
  component "Límite de peticiones" as rl
  component "Proxy de rutas" as px
  component "Agregador de salud" as ha
  auth -right-> rl
  rl -right-> px
}

component "Microservicio Libros" as lib {
  component "routes / controllers" as lib_c
  component "services" as lib_s
  component "repositories" as lib_r
  lib_c -down-> lib_s
  lib_s -down-> lib_r
}

component "Microservicio Ventas" as ven {
  component "routes / controllers" as ven_c
  component "services\n(saga, ranking)" as ven_s
  component "repositories" as ven_r
  component "clients\n(cliente de Libros)" as ven_cl
  ven_c -down-> ven_s
  ven_s -down-> ven_r
  ven_s -right-> ven_cl
}

database "libros_db\n(PostgreSQL)" as dbl
database "ventas_db\n(PostgreSQL)" as dbv

fe -down-( gw : API pública\n/api/v1/*
gw -down-( lib : ILibros\n/api/v1/libros
gw -down-( ven : IVentas, IRanking\n/api/v1/ventas
ven -left-( lib : IExistencias\n/internal/v1/libros
gw ..> lib : ISalud /health
gw ..> ven : ISalud /health

lib_r -down-> dbl : SQL
ven_r -down-> dbv : SQL
@enduml
