# Puerto donde escucha el servicio
PORT=3002
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# PostgreSQL (en AWS: endpoint de RDS ventas y DB_SSL=true)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ventas_db
DB_USER=ventas
DB_PASSWORD=ventas-local-123
DB_SSL=false
# Ruta del bundle de RDS (la imagen ya lo incluye)
# DB_SSL_CA=/app/certs/global-bundle.pem
DB_POOL_MAX=10

# Microservicio de Libros (en AWS: IP privada de la VM de libros)
LIBROS_SERVICE_URL=http://localhost:3001
LIBROS_TIMEOUT_MS=3000
