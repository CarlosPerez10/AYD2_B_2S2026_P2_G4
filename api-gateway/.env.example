# Puerto donde escucha el gateway
PORT=8080
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Llave de administración (mínimo 16 caracteres). En AWS la inyecta Ansible desde Vault.
ADMIN_API_KEY=cambiar-esta-llave-local

# URLs internas de los microservicios
LIBROS_SERVICE_URL=http://localhost:3001
VENTAS_SERVICE_URL=http://localhost:3002

# Tiempos límite (ms)
PROXY_TIMEOUT_MS=10000
HEALTH_TIMEOUT_MS=2000

# Límite de peticiones por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Saltos de proxy confiables (1 = ALB)
TRUST_PROXY_HOPS=1

# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera.
CORS_ORIGINS=
