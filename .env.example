# Variables para docker compose (copiar a .env; .env no se versiona)

APP_VERSION=0.2.0
LOG_LEVEL=info

# Peticiones por minuto e IP en el gateway (subir solo para pruebas de carga)
RATE_LIMIT_MAX=300

# Llave de administración del gateway (mínimo 16 caracteres)
ADMIN_API_KEY=cambiar-esta-llave-local

# Contraseñas de las bases locales
LIBROS_DB_PASSWORD=libros-local-123
VENTAS_DB_PASSWORD=ventas-local-123

# Puertos publicados en el equipo local
GATEWAY_PORT=8080
FRONTEND_PORT=8081
